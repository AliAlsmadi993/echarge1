        <!-- Premium Payment Section -->
        <form method="post" asp-action="ConfirmCheckout" asp-controller="Shop" enctype="multipart/form-data" class="payment-section">
            @Html.AntiForgeryToken()

            <h3><i class="fas fa-wallet"></i> Payment Details</h3>
        <div class="order-summary-text">
            <i class="fas fa-receipt"></i>
            <span>Your total is</span>
            <strong style="color: var(--primary); font-size: 1.3rem;">
                @totalAmount.ToString("0.00") $
            </strong>
        </div>

            <!-- Shipping Address -->
            <div class="form-group">
                <label class="form-label">Delivery Address</label>
                <textarea name="shippingAddress" class="form-control" placeholder="Enter your complete shipping address" rows="4" required></textarea>
            </div>

            <!-- Payment Methods -->
            <div class="payment-methods">
                <div class="payment-methods-title">
                    <i class="fas fa-credit-card"></i> Select Payment Method
                </div>
                <div class="payment-methods-grid">
                    <!-- Orange Money -->
                    <label class="payment-method-card" onclick="selectPaymentMethod('OrangeMoney')">
                        <input type="radio" name="paymentMethod" value="OrangeMoney" required checked>
                        <div class="payment-method-header">
                            <div class="payment-icon-container orange-bg">
                                <i class="fas fa-mobile-alt"></i>
                            </div>
                            <div>
                                <div class="payment-method-title orange-text">Orange Money</div>
                                <div class="payment-method-desc">Instant mobile payment</div>
                            </div>
                        </div>
                    </label>

                    <!-- Credit Card -->
                    <label class="payment-method-card" onclick="selectPaymentMethod('CreditCard')">
                        <input type="radio" name="paymentMethod" value="CreditCard">
                        <div class="payment-method-header">
                            <div class="payment-icon-container credit-bg">
                                <i class="far fa-credit-card"></i>
                            </div>
                            <div>
                                <div class="payment-method-title">Credit Card</div>
                                <div class="payment-method-desc">Visa, Mastercard, etc.</div>
                            </div>
                        </div>
                    </label>

                    <!-- Cash on Delivery -->
                    <label class="payment-method-card" onclick="selectPaymentMethod('CashOnDelivery')">
                        <input type="radio" name="paymentMethod" value="CashOnDelivery">
                        <div class="payment-method-header">
                            <div class="payment-icon-container cash-bg">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <div>
                                <div class="payment-method-title">Cash on Delivery</div>
                                <div class="payment-method-desc">Pay when delivered</div>
                            </div>
                        </div>
                    </label>

                    <!-- Bank Transfer -->
                    <label class="payment-method-card" onclick="selectPaymentMethod('BankTransfer')">
                        <input type="radio" name="paymentMethod" value="BankTransfer">
                        <div class="payment-method-header">
                            <div class="payment-icon-container bank-bg">
                                <i class="fas fa-university"></i>
                            </div>
                            <div>
                                <div class="payment-method-title">Bank Transfer</div>
                                <div class="payment-method-desc">Direct bank payment</div>
