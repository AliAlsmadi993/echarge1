            <!-- Receipt Upload Section -->
            <div id="receiptUploadSection">
                <div class="file-upload-container">
                    <div class="file-upload-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <div class="file-upload-text">
                        Upload your payment confirmation receipt
                    </div>
                    <input type="file" id="fileInput" name="ReceiptImage" style="display: none;" accept="image/*" required>
                    <button type="button" class="file-upload-btn" onclick="document.getElementById('fileInput').click()">
                        <i class="fas fa-upload"></i> Choose File
                    </button>
                </div>
                <small class="form-text" style="display: block; text-align: center; color: #6c757d;">
                    For Orange Money: Send payment to 0777785218 then upload receipt here
                </small>
