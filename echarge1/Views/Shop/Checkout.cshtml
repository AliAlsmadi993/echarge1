@model echarge1.Models.CartItem

@{
    ViewData["Title"] = "Checkout Premium";
    var totalAmount = ViewBag.TotalAmount ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkOut.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        :root {
            --primary: #1abc9c; /* اللون الأساسي - الفيروزي */
            --secondary: #16a085; /* أخضر داكن شوي */
            --accent: #48c9b0; /* لون مساعد أفتح */
            --success: #2ecc71; /* لون نجاح أخضر مائل للزهري */
            --warning: #f39c12; /* أصفر تحذيري */
            --orange: #e67e22; /* برتقالي جميل */
            --dark: #0e4d47; /* أخضر غامق جدًا */
            --light: #ecfdfc; /* أبيض مائل للأخضر */
            --gradient: linear-gradient(135deg, #1abc9c 0%, #16a085 100%);
            --shadow: 0 10px 30px rgba(26, 188, 156, 0.15);
            --transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }


        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f7ff;
            color: var(--dark);
            line-height: 1.7;
        }

        .checkout-premium {
            max-width: 1400px;
            margin: 3rem auto;
            padding: 0 1.5rem;
        }

        .checkout-header {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
        }

            .checkout-header h1 {
                font-size: 2.8rem;
                font-weight: 700;
                background: var(--gradient);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 1rem;
                position: relative;
                display: inline-block;
            }

                .checkout-header h1::after {
                    content: '';
                    position: absolute;
                    bottom: -10px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 100px;
                    height: 4px;
                    background: var(--gradient);
                    border-radius: 2px;
                }

            .checkout-header p {
                font-size: 1.2rem;
                color: #6c757d;
                max-width: 700px;
                margin: 0 auto;
            }

        .checkout-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 2.5rem;
            align-items: start;
        }

        /* Cart Summary - Glassmorphism Style */
        .cart-summary {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

            .cart-summary h3 {
                font-size: 1.5rem;
                font-weight: 600;
                color: var(--dark);
                margin-bottom: 1.5rem;
                display: flex;
                align-items: center;
                gap: 12px;
                position: relative;
            }

                .cart-summary h3::after {
                    content: '';
                    position: absolute;
                    bottom: -10px;
                    left: 0;
                    width: 50px;
                    height: 3px;
                    background: var(--accent);
                }

        .cart-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 15px;
            margin-bottom: 1.5rem;
        }

            .cart-table thead th {
                background: var(--gradient);
                color: white;
                padding: 15px;
                font-weight: 500;
                text-align: left;
            }

            .cart-table th:first-child {
                border-radius: 10px 0 0 10px;
            }

            .cart-table th:last-child {
                border-radius: 0 10px 10px 0;
            }

            .cart-table tbody tr {
                background: white;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
                transition: var(--transition);
            }

                .cart-table tbody tr:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
                }

            .cart-table td {
                padding: 15px;
                vertical-align: middle;
            }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-img {
            width: 60px;
            height: 60px;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .total-amount {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            text-align: right;
            font-size: 1.3rem;
            font-weight: 600;
            margin-top: 2rem;
        }

            .total-amount span {
                color: var(--accent);
                font-size: 1.5rem;
            }

        /* Payment Section - Neumorphism Style */
        .payment-section {
            background: linear-gradient(145deg, #ffffff, #f0f0f0);
            border-radius: 25px;
            padding: 2.5rem;
            box-shadow: 20px 20px 60px #d9d9d9, -20px -20px 60px #ffffff;
            position: relative;
            overflow: hidden;
        }

            .payment-section::before {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 100px;
                height: 100px;
                background: var(--accent);
                border-radius: 0 0 0 100%;
                opacity: 0.1;
            }

            .payment-section h3 {
                font-size: 1.5rem;
                font-weight: 600;
                color: var(--dark);
                margin-bottom: 1.5rem;
                display: flex;
                align-items: center;
                gap: 12px;
                position: relative;
                z-index: 1;
            }

        .form-group {
            margin-bottom: 1.8rem;
            position: relative;
            z-index: 1;
        }

        .form-label {
            display: block;
            margin-bottom: 0.8rem;
            font-weight: 500;
            color: var(--dark);
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 15px 20px;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            background: rgba(255, 255, 255, 0.8);
            box-shadow: inset 5px 5px 10px #e0e0e0, inset -5px -5px 10px #ffffff;
            transition: var(--transition);
        }

            .form-control:focus {
                box-shadow: inset 2px 2px 5px #e0e0e0, inset -2px -2px 5px #ffffff;
                outline: none;
            }

        /* Payment Methods - Card Style */
        .payment-methods {
            margin: 2rem 0;
        }

        .payment-methods-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .payment-methods-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .payment-method-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

            .payment-method-card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: var(--accent);
                opacity: 0;
                transition: var(--transition);
            }

            .payment-method-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            }

            .payment-method-card.active {
                border-color: var(--accent);
                background: rgba(67, 97, 238, 0.03);
            }

                .payment-method-card.active::after {
                    opacity: 1;
                }

            .payment-method-card input[type="radio"] {
                position: absolute;
                opacity: 0;
            }

        .payment-method-header {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .payment-icon-container {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 1.5rem;
        }

        .orange-bg {
            background: rgba(248, 150, 30, 0.1);
            color: var(--orange);
        }

        .credit-bg {
            background: rgba(26, 26, 46, 0.1);
            color: var(--dark);
        }

        .cash-bg {
            background: rgba(76, 201, 240, 0.1);
            color: var(--success);
        }

        .bank-bg {
            background: rgba(243, 37, 133, 0.1);
            color: var(--warning);
        }

        .payment-method-title {
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 3px;
        }

        .payment-method-desc {
            font-size: 0.85rem;
            color: #6c757d;
            line-height: 1.5;
        }

        /* File Upload - Modern Style */
        .file-upload-container {
            border: 2px dashed #dee2e6;
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 1.5rem;
            transition: var(--transition);
            background: rgba(255, 255, 255, 0.5);
            position: relative;
            overflow: hidden;
        }

            .file-upload-container:hover {
                border-color: var(--accent);
                background: rgba(67, 97, 238, 0.03);
            }

        .file-upload-icon {
            font-size: 2.5rem;
            color: var(--accent);
            margin-bottom: 1rem;
            display: inline-block;
            transition: var(--transition);
        }

        .file-upload-text {
            font-size: 1rem;
            color: #6c757d;
            margin-bottom: 1.5rem;
        }

        .file-upload-btn {
            background: var(--gradient);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 500;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .file-upload-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(67, 97, 238, 0.4);
            }

        /* Card Details - Floating Label */
        .card-details-section {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 1.5rem;
            display: none;
        }

        .floating-label-group {
            position: relative;
            margin-bottom: 1.5rem;
        }

        .floating-label {
            position: absolute;
            top: 15px;
            left: 20px;
            font-size: 0.9rem;
            color: #6c757d;
            transition: var(--transition);
            pointer-events: none;
            background: white;
            padding: 0 5px;
        }

        .floating-input:focus + .floating-label,
        .floating-input:not(:placeholder-shown) + .floating-label {
            top: -10px;
            left: 15px;
            font-size: 0.75rem;
            color: var(--accent);
        }

        .floating-input {
            width: 100%;
            padding: 15px 20px;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            font-size: 1rem;
            transition: var(--transition);
        }

            .floating-input:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);
                outline: none;
            }

        /* Submit Button - Animated */
        .submit-btn-container {
            position: relative;
            margin-top: 2rem;
            z-index: 1;
        }

        .submit-btn {
            background: var(--gradient);
            color: white;
            border: none;
            padding: 18px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 15px;
            cursor: pointer;
            transition: var(--transition);
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(67, 97, 238, 0.3);
            z-index: 1;
        }

            .submit-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
                transition: 0.5s;
                z-index: -1;
            }

            .submit-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(67, 97, 238, 0.4);
            }

                .submit-btn:hover::before {
                    left: 100%;
                }

        /* Alert Notifications - Modern */
        .alert-notification {
            border-radius: 12px;
            padding: 1.2rem 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            position: relative;
            overflow: hidden;
        }

            .alert-notification::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 5px;
                height: 100%;
            }

        .alert-danger {
            background: rgba(247, 37, 133, 0.05);
            border: 1px solid rgba(247, 37, 133, 0.2);
        }

            .alert-danger::before {
                background: var(--warning);
            }

        .alert-success {
            background: rgba(76, 201, 240, 0.05);
            border: 1px solid rgba(76, 201, 240, 0.2);
        }

            .alert-success::before {
                background: var(--success);
            }

        .alert-icon {
            font-size: 1.5rem;
        }

        .danger-icon {
            color: var(--warning);
        }

        .success-icon {
            color: var(--success);
        }

        .alert-content {
            flex: 1;
        }

        .alert-title {
            font-weight: 600;
            margin-bottom: 5px;
        }

  

    </style>
}

@if (TempData["Error"] != null)
{
    <div class="alert-notification alert-danger">
        <div class="alert-icon danger-icon">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <div class="alert-content">
            <div class="alert-title">Payment Error</div>
            <div>@TempData["Error"]</div>
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert-notification alert-success">
        <div class="alert-icon success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="alert-content">
            <div class="alert-title">Payment Successful</div>
            <div>@TempData["Success"]</div>
        </div>
    </div>
}

