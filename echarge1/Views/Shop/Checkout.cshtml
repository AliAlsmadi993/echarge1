            <!-- Card Details Section -->
            <div id="cardDetailsSection" class="card-details-section">
                <div class="floating-label-group">
                    <input type="text" id="cardNumber" name="cardNumber" class="floating-input" placeholder=" ">
                    <label class="floating-label">Card Number</label>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="floating-label-group">
                        <input type="text" id="cardExpiry" name="cardExpiry" class="floating-input" placeholder=" ">
                        <label class="floating-label">Expiry Date</label>
                    </div>
                    <div class="floating-label-group">
                        <input type="text" id="cardCvv" name="cardCvv" class="floating-input" placeholder=" ">
                        <label class="floating-label">CVV</label>
                    </div>
                </div>
            </div>

            <!-- Secure Payment Badge -->
            <div style="display: flex; align-items: center; justify-content: center; gap: 15px; margin: 1.5rem 0;">
                <img src="https://cdn-icons-png.flaticon.com/512/196/196578.png" alt="SSL Secure" style="height: 30px;">
                <img src="https://cdn-icons-png.flaticon.com/512/196/196566.png" alt="PCI DSS" style="height: 30px;">
                <small style="color: #6c757d;">Your payment is 100% secure</small>
            </div>

            <!-- Submit Button -->
            <div class="submit-btn-container">
                <button type="submit" class="submit-btn">
                    <i class="fas fa-lock"></i> Complete Secure Payment
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function selectPaymentMethod(method) {
            // Update active state for payment cards
            document.querySelectorAll('.payment-method-card').forEach(card => {
                card.classList.remove('active');
            });
            event.currentTarget.classList.add('active');

            // Show/hide sections based on selected method
            const receiptSection = document.getElementById('receiptUploadSection');
            const cardSection = document.getElementById('cardDetailsSection');
            const fileInput = receiptSection.querySelector('input[type="file"]');

            if (method === 'CreditCard') {
                receiptSection.style.display = 'none';
                cardSection.style.display = 'block';
                fileInput.required = false;
            } else {
                receiptSection.style.display = 'block';
                cardSection.style.display = 'none';

                // Only require receipt for non-cash methods
                if (method === 'CashOnDelivery') {
                    fileInput.required = false;
                } else {
                    fileInput.required = true;
                }
            }
        }

        // Initialize with Orange Money selected
        document.addEventListener('DOMContentLoaded', function() {
            selectPaymentMethod('OrangeMoney');

            // Enhance file input display
            const fileInput = document.getElementById('fileInput');
            fileInput.addEventListener('change', function() {
                if (this.files.length > 0) {
                    const fileName = this.files[0].name;
                    const uploadText = document.querySelector('.file-upload-text');
                    uploadText.innerHTML = `
                        <i class="fas fa-check-circle" style="color: #4cc9f0;"></i>
                        <div>${fileName}</div>
                    `;
                }
            });
        });

        // Add animation to payment cards on hover
        document.querySelectorAll('.payment-method-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                if (!this.classList.contains('active')) {
                    this.style.transform = 'translateY(-5px)';
                    this.style.boxShadow = '0 10px 25px rgba(0, 0, 0, 0.1)';
                }
            });

            card.addEventListener('mouseleave', function() {
                if (!this.classList.contains('active')) {
                    this.style.transform = '';
                    this.style.boxShadow = '';
                }
            });
        });
    </script>
}